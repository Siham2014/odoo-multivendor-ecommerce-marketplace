<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Vendor Portal User Group -->
        <record id="vendor_portal_user" model="res.groups">
            <field name="name">Vendor Portal User</field>
            <field name="category_id" ref="base.module_category_tools"/>
            <field name="comment">Users with access to the Vendor Portal</field>
        </record>

        <!-- Portal Module Access -->
        <record id="vendor_portal_access_rule" model="ir.rule">
            <field name="name">Vendor Portal Access</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="groups" eval="[(4, ref('vendor_portal_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[]</field>
        </record>
    </data>
</odoo>
