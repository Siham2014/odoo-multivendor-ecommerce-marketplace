<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Dashboard Template -->
        <template id="portal_dashboard" name="Vendor Portal Dashboard">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <div class="row mb-4">
                        <div class="col-lg-12">
                            <div class="card border-0 shadow-sm" style="border-top: 4px solid #FF6B35;">
                                <div class="card-body">
                                    <h1 class="card-title" style="color: #1A1A1A;">
                                        <i class="fa fa-store"></i> Tableau de bord vendeur
                                    </h1>
                                    <p class="text-muted">Bienvenue, <strong t-esc="vendor.name"/></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Stats -->
                    <div class="row mb-5">
                        <div class="col-md-3 mb-3">
                            <div class="card h-100 border-0 shadow-sm" style="background: linear-gradient(135deg, #FF6B35 0%, #FF8A50 100%);">
                                <div class="card-body text-white">
                                    <p class="card-text mb-2">Produits actifs</p>
                                    <h3 class="mb-0">12</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="card h-100 border-0 shadow-sm" style="background: linear-gradient(135deg, #004E89 0%, #0A7E8C 100%);">
                                <div class="card-body text-white">
                                    <p class="card-text mb-2">Commandes</p>
                                    <h3 class="mb-0">45</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="card h-100 border-0 shadow-sm" style="background: linear-gradient(135deg, #9D4EDD 0%, #C77DFF 100%);">
                                <div class="card-body text-white">
                                    <p class="card-text mb-2">Tickets SAV</p>
                                    <h3 class="mb-0">3</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="card h-100 border-0 shadow-sm" style="background: linear-gradient(135deg, #10B981 0%, #34D399 100%);">
                                <div class="card-body text-white">
                                    <p class="card-text mb-2">Revenus</p>
                                    <h3 class="mb-0">2 500€</h3>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Navigation Cards -->
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <a href="/vendor/products" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100 portal-nav-card">
                                    <div class="card-body d-flex align-items-center">
                                        <div class="icon-box" style="background: #FFF3E0; width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 20px;">
                                            <i class="fa fa-box" style="font-size: 24px; color: #FF6B35;"></i>
                                        </div>
                                        <div>
                                            <h5 class="mb-1" style="color: #1A1A1A;">Mes produits</h5>
                                            <p class="text-muted mb-0">Gérer votre catalogue</p>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6 mb-4">
                            <a href="/vendor/orders" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100 portal-nav-card">
                                    <div class="card-body d-flex align-items-center">
                                        <div class="icon-box" style="background: #E0F2FE; width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 20px;">
                                            <i class="fa fa-shopping-cart" style="font-size: 24px; color: #004E89;"></i>
                                        </div>
                                        <div>
                                            <h5 class="mb-1" style="color: #1A1A1A;">Commandes</h5>
                                            <p class="text-muted mb-0">Suivre vos commandes</p>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6 mb-4">
                            <a href="/vendor/delivery" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100 portal-nav-card">
                                    <div class="card-body d-flex align-items-center">
                                        <div class="icon-box" style="background: #F3E8FF; width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 20px;">
                                            <i class="fa fa-truck" style="font-size: 24px; color: #9D4EDD;"></i>
                                        </div>
                                        <div>
                                            <h5 class="mb-1" style="color: #1A1A1A;">Livraisons</h5>
                                            <p class="text-muted mb-0">Suivi des livraisons</p>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6 mb-4">
                            <a href="/vendor/sav" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100 portal-nav-card">
                                    <div class="card-body d-flex align-items-center">
                                        <div class="icon-box" style="background: #F0FDF4; width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 20px;">
                                            <i class="fa fa-headset" style="font-size: 24px; color: #10B981;"></i>
                                        </div>
                                        <div>
                                            <h5 class="mb-1" style="color: #1A1A1A;">SAV</h5>
                                            <p class="text-muted mb-0">Tickets support</p>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6 mb-4">
                            <a href="/vendor/notifications" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100 portal-nav-card">
                                    <div class="card-body d-flex align-items-center">
                                        <div class="icon-box" style="background: #FEF3C7; width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 20px;">
                                            <i class="fa fa-bell" style="font-size: 24px; color: #F59E0B;"></i>
                                        </div>
                                        <div>
                                            <h5 class="mb-1" style="color: #1A1A1A;">Notifications</h5>
                                            <p class="text-muted mb-0">Vos alertes</p>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6 mb-4">
                            <a href="/web" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100 portal-nav-card">
                                    <div class="card-body d-flex align-items-center">
                                        <div class="icon-box" style="background: #E5E7EB; width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 20px;">
                                            <i class="fa fa-cog" style="font-size: 24px; color: #6B7280;"></i>
                                        </div>
                                        <div>
                                            <h5 class="mb-1" style="color: #1A1A1A;">Paramètres</h5>
                                            <p class="text-muted mb-0">Configuration</p>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Products Template -->
        <template id="portal_products" name="Vendor Products">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <div class="row mb-4">
                        <div class="col-lg-8">
                            <h2 style="color: #1A1A1A;">Mes produits</h2>
                        </div>
                        <div class="col-lg-4 text-end">
                            <a href="/vendor/add-product" class="btn btn-lg" style="background: #FF6B35; color: white; border: none;">
                                <i class="fa fa-plus"></i> Ajouter un produit
                            </a>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead style="background: #F5F5F5;">
                                <tr>
                                    <th>Produit</th>
                                    <th>SKU</th>
                                    <th>Prix</th>
                                    <th>Stock</th>
                                    <th>Statut</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="products" t-as="product">
                                    <td t-esc="product.name"/>
                                    <td t-esc="product.default_code or '-'"/>
                                    <td t-esc="product.list_price"/>
                                    <td t-esc="product.qty_available"/>
                                    <td>
                                        <span class="badge" style="background: #10B981;">Actif</span>
                                    </td>
                                    <td>
                                        <a href="#" class="btn btn-sm btn-outline-secondary">Éditer</a>
                                        <a href="#" class="btn btn-sm btn-outline-danger">Supprimer</a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </template>

        <!-- Add Product Template -->
        <template id="portal_add_product" name="Add Product">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-lg-8 offset-lg-2">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header" style="background: #FF6B35; color: white; border: none;">
                                    <h4 class="mb-0">Ajouter un nouveau produit</h4>
                                </div>
                                <div class="card-body p-4">
                                    <t t-if="error">
                                        <div class="alert alert-danger alert-dismissible fade show">
                                            <t t-esc="error"/>
                                        </div>
                                    </t>
                                    <form method="post" class="needs-validation">
                                        <div class="mb-3">
                                            <label class="form-label">Nom du produit</label>
                                            <input type="text" class="form-control" name="name" required="True"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Prix</label>
                                            <input type="number" class="form-control" name="price" step="0.01" required="True"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Description</label>
                                            <textarea class="form-control" name="description" rows="5"></textarea>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <button type="submit" class="btn btn-lg" style="background: #FF6B35; color: white; border: none;">
                                                <i class="fa fa-save"></i> Enregistrer
                                            </button>
                                            <a href="/vendor/products" class="btn btn-lg btn-outline-secondary">Annuler</a>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Orders Template -->
        <template id="portal_orders" name="Vendor Orders">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <h2 style="color: #1A1A1A; margin-bottom: 30px;">Commandes</h2>

                    <div class="row">
                        <t t-foreach="orders" t-as="order">
                            <div class="col-md-6 mb-4">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-header" style="background: #004E89; color: white; border: none;">
                                        <h5 class="mb-0">Commande <t t-esc="order.name"/></h5>
                                    </div>
                                    <div class="card-body">
                                        <p><strong>Client:</strong> <t t-esc="order.partner_id.name"/></p>
                                        <p><strong>Montant:</strong> <t t-esc="order.amount_total"/> €</p>
                                        <p><strong>Date:</strong> <t t-esc="order.create_date.strftime('%d/%m/%Y')"/></p>
                                        <p><strong>Statut:</strong> <span class="badge" t-attf-style="background: {% if order.state == 'sale' %}#10B981{% elif order.state == 'draft' %}#F59E0B{% else %}#EF4444{% endif %};" t-esc="order.state"/></p>
                                    </div>
                                    <div class="card-footer bg-white border-top">
                                        <a href="#" class="btn btn-sm btn-outline-primary">Voir détails</a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </template>

        <!-- Delivery Template -->
        <template id="portal_delivery" name="Vendor Delivery">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <h2 style="color: #1A1A1A; margin-bottom: 30px;">Suivi des livraisons</h2>

                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead style="background: #F5F5F5;">
                                <tr>
                                    <th>Numéro</th>
                                    <th>Client</th>
                                    <th>Adresse</th>
                                    <th>Statut</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="delivery_tasks" t-as="task">
                                    <td t-esc="task.name"/>
                                    <td t-esc="task.customer_id.name" t-if="task.customer_id"/>
                                    <td t-esc="task.delivery_address" t-if="task.delivery_address"/>
                                    <td>
                                        <span class="badge" style="background: #9D4EDD;">
                                            <t t-esc="task.state"/>
                                        </span>
                                    </td>
                                    <td t-esc="task.trigger_datetime.strftime('%d/%m/%Y %H:%M')" t-if="task.trigger_datetime"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </template>

        <!-- SAV Template -->
        <template id="portal_sav" name="Vendor SAV">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <h2 style="color: #1A1A1A; margin-bottom: 30px;">Tickets de support</h2>

                    <div class="row">
                        <t t-foreach="sav_tickets" t-as="ticket">
                            <div class="col-md-6 mb-4">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-header" style="background: #10B981; color: white; border: none;">
                                        <h5 class="mb-0">Ticket #<t t-esc="ticket.id"/></h5>
                                    </div>
                                    <div class="card-body">
                                        <p><strong>Sujet:</strong> <t t-esc="ticket.subject" t-if="ticket.subject"/></p>
                                        <p><strong>Client:</strong> <t t-esc="ticket.customer_id.name" t-if="ticket.customer_id"/></p>
                                        <p><strong>Priorité:</strong> <t t-esc="ticket.priority" t-if="ticket.priority"/></p>
                                        <p><strong>Statut:</strong> <t t-esc="ticket.state"/></p>
                                        <p class="text-muted small"><t t-esc="ticket.description" t-if="ticket.description"/></p>
                                    </div>
                                    <div class="card-footer bg-white border-top">
                                        <a href="#" class="btn btn-sm btn-outline-primary">Répondre</a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </template>

        <!-- Notifications Template -->
        <template id="portal_notifications" name="Vendor Notifications">
            <t t-call="website.layout">
                <div class="container mt-5 mb-5">
                    <h2 style="color: #1A1A1A; margin-bottom: 30px;">Notifications</h2>

                    <div class="list-group">
                        <t t-foreach="notifications" t-as="notification">
                            <a href="#" class="list-group-item list-group-item-action border-0 shadow-sm mb-2">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h5 class="mb-1" t-esc="notification.notification_type" t-if="notification.notification_type"/>
                                        <p class="mb-1 text-muted" t-esc="notification.message" t-if="notification.message"/>
                                        <small class="text-muted" t-esc="notification.trigger_datetime.strftime('%d/%m/%Y %H:%M')" t-if="notification.trigger_datetime"/>
                                    </div>
                                    <span class="badge bg-primary" t-if="not notification.is_read">Nouveau</span>
                                </div>
                            </a>
                        </t>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>
