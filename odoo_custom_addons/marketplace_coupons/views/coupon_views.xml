<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Coupon Tree View -->
<record id="marketplace_coupons_view_coupon_tree" model="ir.ui.view">
<field name="name">marketplace.coupon.tree</field>
<field name="model">marketplace.coupon</field>
<field name="arch" type="xml">
<tree>
<field name="code"/>
<field name="coupon_type"/>
<field name="amount"/>
<field name="vendor_id"/>
<field name="valid_from"/>
<field name="valid_to"/>
<field name="usage_count"/>
<field name="usage_limit"/>
<field name="active" invisible="1"/>
</tree>
</field>
</record>

<!-- Coupon Form View -->
<record id="marketplace_coupons_view_coupon_form" model="ir.ui.view">
<field name="name">marketplace.coupon.form</field>
<field name="model">marketplace.coupon</field>
<field name="arch" type="xml">
<form>
<sheet>
<div class="oe_button_box" name="button_box">
<button name="action_increment_usage" type="object" class="oe_stat_button" icon="fa-arrow-up">
<field name="usage_count" widget="statinfo"/>
</button>
</div>
<div class="oe_title">
<h1>
<field name="name" placeholder="Coupon Name"/>
</h1>
</div>
<group>
<group>
<field name="code"/>
<field name="coupon_type"/>
<field name="amount"/>
<field name="is_valid" readonly="1"/>
</group>
<group>
<field name="vendor_id"/>
<field name="active"/>
</group>
</group>
<group string="Validity">
<field name="valid_from"/>
<field name="valid_to"/>
</group>
<group string="Usage Limits">
<field name="usage_limit"/>
<field name="usage_count" readonly="1"/>
</group>
<group string="Notes">
<field name="notes" placeholder="Internal notes..."/>
</group>
</sheet>
</form>
</field>
</record>

<!-- Coupon Search View -->
<record id="marketplace_coupons_view_coupon_search" model="ir.ui.view">
<field name="name">marketplace.coupon.search</field>
<field name="model">marketplace.coupon</field>
<field name="arch" type="xml">
<search>
<field name="code"/>
<field name="vendor_id"/>
<field name="coupon_type"/>
<separator/>
<filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
<filter name="filter_inactive" string="Inactive" domain="[('active', '=', False)]"/>
<separator/>
<group string="Group By" expand="0">
<filter name="group_by_vendor" string="Vendor" context="{'group_by': 'vendor_id'}"/>
<filter name="group_by_type" string="Type" context="{'group_by': 'coupon_type'}"/>
<filter name="group_by_status" string="Active Status" context="{'group_by': 'active'}"/>
</group>
</search>
</field>
</record>

<!-- Coupon Kanban View -->
<record id="marketplace_coupons_view_coupon_kanban" model="ir.ui.view">
<field name="name">marketplace.coupon.kanban</field>
<field name="model">marketplace.coupon</field>
<field name="arch" type="xml">
<kanban>
<templates>
<t t-name="kanban-box">
<div class="oe_kanban_card oe_kanban_global_click">
<div class="oe_kanban_content">
<strong><field name="code"/></strong>
<br/>
<span t-attf-class="badge {'badge-success' if record.is_valid.raw_value else 'badge-danger'}">
<field name="coupon_type"/>
</span>
<br/>
<div class="mt-2">
<field name="amount"/> - <field name="vendor_id"/>
</div>
<small>Valid: <field name="valid_from"/> to <field name="valid_to"/></small>
</div>
</div>
</t>
</templates>
</kanban>
</field>
</record>

<!-- Coupon Pivot View -->
<record id="marketplace_coupons_view_coupon_pivot" model="ir.ui.view">
<field name="name">marketplace.coupon.pivot</field>
<field name="model">marketplace.coupon</field>
<field name="arch" type="xml">
<pivot>
<field name="coupon_type" type="row"/>
<field name="vendor_id" type="col"/>
<field name="amount" type="measure" widget="float"/>
<field name="usage_count" type="measure"/>
</pivot>
</field>
</record>

<!-- Coupon Graph View -->
<record id="marketplace_coupons_view_coupon_graph" model="ir.ui.view">
<field name="name">marketplace.coupon.graph</field>
<field name="model">marketplace.coupon</field>
<field name="arch" type="xml">
<graph string="Coupon Analysis" type="bar">
<field name="coupon_type" type="row"/>
<field name="amount" type="measure" widget="float"/>
</graph>
</field>
</record>
</odoo>
