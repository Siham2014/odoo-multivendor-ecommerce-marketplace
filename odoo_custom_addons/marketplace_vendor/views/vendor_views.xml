<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- VENDOR VIEWS -->

    <!-- Tree View -->
    <record id="marketplace_vendor_tree_view" model="ir.ui.view">
        <field name="name">Vendor Tree</field>
        <field name="model">marketplace.vendor</field>
        <field name="arch" type="xml">
            <tree string="Vendors" decoration-success="status=='active'" decoration-warning="status=='suspended'" decoration-danger="status=='banned'">
                <field name="name"/>
                <field name="commission_rate"/>
                <field name="total_products"/>
                <field name="status"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="marketplace_vendor_form_view" model="ir.ui.view">
        <field name="name">Vendor Form</field>
        <field name="model">marketplace.vendor</field>
        <field name="arch" type="xml">
            <form string="Vendor">
                <header>
                    <button name="action_activate_vendor" type="object" string="Activate" class="oe_highlight" states="suspended,banned"/>
                    <button name="action_suspend_vendor" type="object" string="Suspend" class="oe_highlight" states="active"/>
                    <button name="action_ban_vendor" type="object" string="Ban" class="oe_highlight"/>
                    <field name="status" widget="statusbar" options="{'clickable': False}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="commission_rate"/>
                        </group>
                        <group>
                            <field name="total_products"/>
                            <field name="total_sales"/>
                            <field name="return_rate"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" nolabel="1"/>
                        </page>
                        <page string="Products">
                            <field name="product_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="price"/>
                                    <field name="quantity_available"/>
                                    <field name="is_active"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Payouts">
                            <field name="payout_ids" nolabel="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="amount"/>
                                    <field name="state"/>
                                    <field name="scheduled_date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="marketplace_vendor_kanban_view" model="ir.ui.view">
        <field name="name">Vendor Kanban</field>
        <field name="model">marketplace.vendor</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="true">
                <field name="id"/>
                <field name="name"/>
                <field name="status"/>
                <field name="commission_rate"/>
                <field name="total_products"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <span t-field="record.name.value"/>
                                    </strong>
                                </div>
                                <small class="o_kanban_record_subtitle" t-if="record.status.raw_value == 'active'">
                                    <span class="badge badge-success">Active</span>
                                </small>
                                <small class="o_kanban_record_subtitle" t-if="record.status.raw_value == 'suspended'">
                                    <span class="badge badge-warning">Suspended</span>
                                </small>
                                <small class="o_kanban_record_subtitle" t-if="record.status.raw_value == 'banned'">
                                    <span class="badge badge-danger">Banned</span>
                                </small>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>Commission: <t t-field="record.commission_rate"/>%</div>
                                <div>Products: <t t-field="record.total_products"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="marketplace_vendor_search_view" model="ir.ui.view">
        <field name="name">Vendor Search</field>
        <field name="model">marketplace.vendor</field>
        <field name="arch" type="xml">
            <search string="Search Vendors">
                <field name="name" string="Vendor Name"/>
                <field name="email"/>
                <field name="commission_rate"/>
                <separator/>
                <filter string="Active" name="active" domain="[('status', '=', 'active')]"/>
                <filter string="Suspended" name="suspended" domain="[('status', '=', 'suspended')]"/>
                <filter string="Banned" name="banned" domain="[('status', '=', 'banned')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Commission Rate" name="group_commission" context="{'group_by': 'commission_rate'}"/>
                    <filter string="Create Date" name="group_date" context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
