<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- VENDOR PAYOUT VIEWS -->

    <!-- Tree View -->
    <record id="marketplace_vendor_payout_tree_view" model="ir.ui.view">
        <field name="name">Vendor Payout Tree</field>
        <field name="model">marketplace.vendor.payout</field>
        <field name="arch" type="xml">
            <tree string="Vendor Payouts" decoration-success="state=='paid'" decoration-info="state=='approved'" decoration-warning="state=='draft'">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="amount"/>
                <field name="scheduled_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="marketplace_vendor_payout_form_view" model="ir.ui.view">
        <field name="name">Vendor Payout Form</field>
        <field name="model">marketplace.vendor.payout</field>
        <field name="arch" type="xml">
            <form string="Vendor Payout">
                <header>
                    <button name="action_approve_payout" type="object" string="Approve" class="oe_highlight" states="draft"/>
                    <button name="action_mark_paid" type="object" string="Mark as Paid" class="oe_highlight" states="approved"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" states="approved,paid"/>
                    <field name="state" widget="statusbar" options="{'clickable': False}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="amount"/>
                            <field name="scheduled_date"/>
                        </group>
                        <group>
                            <field name="payment_reference" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                    <field name="notes" nolabel="1" placeholder="Enter payout notes here..."/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="marketplace_vendor_payout_search_view" model="ir.ui.view">
        <field name="name">Vendor Payout Search</field>
        <field name="model">marketplace.vendor.payout</field>
        <field name="arch" type="xml">
            <search string="Search Vendor Payouts">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="payment_reference"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Vendor" name="group_vendor" context="{'group_by': 'vendor_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'state'}"/>
                    <filter string="Scheduled Date" name="group_date" context="{'group_by': 'scheduled_date'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
