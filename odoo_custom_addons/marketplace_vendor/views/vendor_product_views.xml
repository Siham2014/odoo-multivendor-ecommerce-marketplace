<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- VENDOR PRODUCT VIEWS -->

    <!-- Tree View -->
    <record id="marketplace_vendor_product_tree_view" model="ir.ui.view">
        <field name="name">Vendor Product Tree</field>
        <field name="model">marketplace.vendor.product</field>
        <field name="arch" type="xml">
            <tree string="Vendor Products" decoration-success="is_active" decoration-muted="not is_active">
                <field name="product_id"/>
                <field name="vendor_id"/>
                <field name="price"/>
                <field name="quantity_available"/>
                <field name="is_active"/>
                <field name="total_sales"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="marketplace_vendor_product_form_view" model="ir.ui.view">
        <field name="name">Vendor Product Form</field>
        <field name="model">marketplace.vendor.product</field>
        <field name="arch" type="xml">
            <form string="Vendor Product">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="product_id" options="{'no_create': True}"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="price"/>
                            <field name="quantity_available"/>
                        </group>
                        <group>
                            <field name="is_active"/>
                            <field name="total_sales"/>
                            <field name="creation_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="marketplace_vendor_product_search_view" model="ir.ui.view">
        <field name="name">Vendor Product Search</field>
        <field name="model">marketplace.vendor.product</field>
        <field name="arch" type="xml">
            <search string="Search Vendor Products">
                <field name="product_id"/>
                <field name="vendor_id"/>
                <field name="price"/>
                <separator/>
                <filter string="Active" name="active" domain="[('is_active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('is_active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Vendor" name="group_vendor" context="{'group_by': 'vendor_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'is_active'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
