<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- TREE VIEW -->
    <record id="sav_ticket_tree" model="ir.ui.view">
        <field name="name">SAV Ticket Tree</field>
        <field name="model">sav.ticket</field>
        <field name="arch" type="xml">
            <tree decoration-danger="state == 'rejected'" decoration-success="state == 'refunded'" decoration-warning="state == 'in_progress'">
                <field name="name" />
                <field name="customer_id" />
                <field name="product_id" />
                <field name="order_id" />
                <field name="reason" />
                <field name="state" />
                <field name="responsible_id" />
                <field name="create_date" />
            </tree>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="sav_ticket_form" model="ir.ui.view">
        <field name="name">SAV Ticket Form</field>
        <field name="model">sav.ticket</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="button_submit" string="Submit" type="object" class="oe_highlight" states="draft" />
                    <button name="button_assign" string="Assign" type="object" states="submitted" />
                    <button name="button_start" string="Start" type="object" states="assigned" />
                    <button name="button_approve" string="Approve Claim" type="object" class="oe_highlight" states="in_progress" groups="marketplace_sav.group_sav_manager" />
                    <button name="button_reject" string="Reject Claim" type="object" states="in_progress" groups="marketplace_sav.group_sav_manager" />
                    <button name="button_refund" string="Refund Customer" type="object" class="oe_highlight" states="approved" groups="marketplace_sav.group_sav_manager" />
                    <button name="button_close" string="Close Ticket" type="object" states="rejected,refunded" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,assigned,in_progress,approved,rejected,refunded,closed" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_order" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="order_id" widget="statinfo" string="Order" />
                        </button>
                    </div>

                    <h1>
                        <field name="name" class="oe_inline" readonly="1" />
                    </h1>

                    <div class="oe_title">
                        <label for="reason" />
                        <h2>
                            <field name="reason" />
                        </h2>
                    </div>

                    <group>
                        <group>
                            <field name="order_id" />
                            <field name="customer_id" />
                            <field name="product_id" />
                            <field name="create_date" />
                        </group>
                        <group>
                            <field name="responsible_id" />
                            <field name="state" />
                            <field name="days_since_creation" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Claim Details">
                            <group>
                                <field name="description" nolabel="1" />
                            </group>
                            <group>
                                <label for="image" />
                                <field name="image" widget="image" />
                            </group>
                        </page>

                        <page string="Resolution">
                            <group>
                                <field name="resolution_notes" nolabel="1" />
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <!-- KANBAN VIEW -->
    <record id="sav_ticket_kanban" model="ir.ui.view">
        <field name="name">SAV Ticket Kanban</field>
        <field name="model">sav.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <span t-field="record.name" />
                                    </strong>
                                </div>
                                <small class="oe_kanban_small_subtitle">
                                    <t t-esc="record.reason.value" />
                                </small>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <strong>Customer:</strong>
                                    <span t-field="record.customer_id.name" />
                                </div>
                                <div>
                                    <strong>Product:</strong>
                                    <span t-field="record.product_id.name" />
                                </div>
                                <div>
                                    <strong>Days:</strong>
                                    <span t-field="record.days_since_creation" />
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <img t-att-src="kanban_image('res.users', 'image_128', record.responsible_id.raw_value)" t-att-title="record.responsible_id.name" class="oe_kanban_avatar" alt="Avatar" />
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span t-field="record.create_date" widget="date" />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
