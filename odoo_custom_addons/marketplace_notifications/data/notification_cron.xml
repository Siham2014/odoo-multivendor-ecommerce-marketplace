<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- Cron Job: Generate Sample Notifications (Runs every 6 hours) -->
<record id="marketplace_notifications_cron_generate_notifications" model="ir.cron">
<field name="name">Marketplace: Generate Sample Notifications</field>
<field name="model_id" ref="model_marketplace_notification"/>
<field name="state">code</field>
<field name="code">model._generate_sample_notifications()</field>
<field name="interval_number">6</field>
<field name="interval_type">hours</field>
<field name="numbercall">-1</field>
<field name="active">False</field>
</record>

</odoo>
