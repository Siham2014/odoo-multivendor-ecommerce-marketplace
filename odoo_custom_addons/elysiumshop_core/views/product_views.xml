<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend Product Form View to add seller_id field -->
    <record id="product_template_elysiumshop_form" model="ir.ui.view">
        <field name="name">Product Template - ElysiumShop Form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <group name="elysiumshop_fields">
                    <group>
                        <field name="seller_id" />
                        <field name="vendor_sku" />
                    </group>
                    <group>
                        <field name="is_marketplace_product" />
                        <field name="commission_amount" readonly="1" />
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Extend Product Tree View to show seller_id -->
    <record id="product_template_elysiumshop_tree" model="ir.ui.view">
        <field name="name">Product Template - ElysiumShop Tree</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-muted">is_marketplace_product == False</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="seller_id" />
                <field name="is_marketplace_product" />
            </xpath>
        </field>
    </record>

</odoo>
