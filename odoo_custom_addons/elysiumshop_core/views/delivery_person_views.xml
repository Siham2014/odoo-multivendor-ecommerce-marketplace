<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Delivery Person Tree View -->
    <record id="elysiumshop_delivery_person_tree" model="ir.ui.view">
        <field name="name">Delivery Person Tree View</field>
        <field name="model">elysiumshop.delivery.person</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="email" />
                <field name="phone" />
                <field name="vehicle_type" />
                <field name="status" />
                <field name="on_duty" />
                <field name="total_deliveries" />
                <field name="avg_rating" />
            </tree>
        </field>
    </record>

    <!-- Delivery Person Form View -->
    <record id="elysiumshop_delivery_person_form" model="ir.ui.view">
        <field name="name">Delivery Person Form View</field>
        <field name="model">elysiumshop.delivery.person</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_tasks" type="object" class="oe_stat_button" icon="fa-cube">
                            <field name="total_deliveries" widget="statinfo" string="Deliveries" />
                        </button>
                    </div>
                    
                    <h1>
                        <field name="name" class="oe_inline" />
                    </h1>
                    
                    <div class="oe_title">
                        <label for="status" />
                        <h2>
                            <field name="status" />
                        </h2>
                    </div>
                    
                    <group>
                        <group>
                            <field name="email" />
                            <field name="phone" />
                            <field name="user_id" />
                        </group>
                        <group>
                            <field name="on_duty" />
                            <field name="created_date" />
                            <field name="avg_rating" />
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Vehicle Information">
                            <group>
                                <field name="vehicle_type" />
                                <field name="vehicle_plate" />
                                <field name="zone" />
                            </group>
                        </page>
                        <page string="Address">
                            <group>
                                <field name="street" />
                                <field name="street2" />
                                <field name="city" />
                                <field name="state_id" />
                                <field name="zip" />
                                <field name="country_id" />
                            </group>
                        </page>
                        <page string="Service Areas">
                            <field name="service_area_ids" widget="many2many_tags" />
                        </page>
                    </notebook>
                </sheet>
                
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <!-- Delivery Person Action -->
    <record id="elysiumshop_delivery_person_action" model="ir.actions.act_window">
        <field name="name">Delivery Personnel</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">elysiumshop.delivery.person</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new delivery person profile.
            </p>
        </field>
    </record>


</odoo>
